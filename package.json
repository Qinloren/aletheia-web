{
	"name": "aletheia-web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "一个AI驱动的论坛系统",
	"keywords": [
		"aletheia",
		"ati",
		"forum",
		"论坛"
	],
	"license": "Apache-2.0",
	"scripts": {
		"dev": "vite --mode development",
		"start:dev": "vite --mode development",
		"start:prod": "vite --mode production",
		"start:test": "vite --mode testing",
		"start:staging": "vite --mode staging",
		"build": "pnpm build:prod",
		"build:dev": "pnpm tsc && vite build --mode development",
		"build:prod": "pnpm tsc && vite build --mode production",
		"build:test": "pnpm tsc && vite build --mode testing",
		"build:staging": "pnpm tsc && vite build --mode staging",
		"lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
		"tsc": "tsc --noEmit",
		"prepare": "husky install",
		"commit": "git-cz",
		"release": "standard-version"
	},
	"config": {
		"commitizen": {
			"path": "node_modules/cz-git"
		}
	},
	"dependencies": {
		"axios": "^1.14.0",
		"eslint-import-resolver-alias": "^1.1.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router-dom": "^7.14.0",
		"standard-version": "^9.5.0",
		"supercons": "^0.2.0",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nabla/vite-plugin-eslint": "^3.0.1",
		"@types/node": "latest",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"cz-git": "^1.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.4.0",
		"husky": "^8.0.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"sass": "^1.99.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	}
}
